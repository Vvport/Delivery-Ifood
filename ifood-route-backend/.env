# Credenciais obtidas no portal developer.ifood.com.br (app homologado)
IFOOD_CLIENT_ID=
IFOOD_CLIENT_SECRET=

# ID da loja (merchant) na plataforma iFood
IFOOD_MERCHANT_ID=

# Endereço da loja (CEP e número) — as coordenadas são geocodificadas automaticamente
STORE_CEP=
STORE_NUMBER=

# Servidor OSRM para cálculo de distâncias reais.
OSRM_URL=https://router.project-osrm.org

# Conexão com o banco de dados Postgres (use o docker-compose para subir localmente)
DATABASE_URL=postgresql://ifood:ifood_secret@localhost:5432/ifood_routes

# Chave secreta para autenticar o frontend junto ao backend (deve ser igual ao frontend)
API_KEY=dev-api-key-123

# URL do frontend (usada no CORS)
FRONTEND_URL=http://localhost:3001

PORT=3000
