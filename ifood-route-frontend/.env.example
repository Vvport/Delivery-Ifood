# URL do backend NestJS — usada apenas no servidor Next.js (não expor no browser)
API_URL=http://localhost:3000

# Chave secreta de acesso ao backend (deve ser igual a API_KEY no backend)
API_KEY=change-this-api-key

# Credenciais de acesso ao painel (login simples)
# Troque por um usuário/senha real e, no futuro, por um hash.
APP_USERNAME=loja
APP_PASSWORD=troque-esta-senha